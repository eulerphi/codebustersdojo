module Data exposing (randomKeyword, randomLongQuote, randomQuote)

import Array exposing (Array)
import Extra

randomKeyword : Float -> String
randomKeyword r =
    let
        k = Extra.randomIdx r (Array.length keywords)
            |> (\i -> Array.get i keywords)
            |> Maybe.withDefault "key"

        -- _ = Debug.log "keyword: " k
    in
    k

randomQuote : Float -> String
randomQuote r =
    let
        q = Extra.randomIdx r (Array.length quotes)
            |> (\i -> Array.get i quotes)
            |> Maybe.withDefault "a perfect quote"

        -- _ = Debug.log "quote: " q
    in
    q

randomLongQuote : Float -> String
randomLongQuote r =
    let
        q = Extra.randomIdx r (Array.length longQuotes)
            |> (\i -> Array.get i longQuotes)
            |> Maybe.withDefault "a perfect quote"

        -- _ = Debug.log "longquote: " q
    in
    q


